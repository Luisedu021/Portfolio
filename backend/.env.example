# Copie para backend/.env e preencha. Nada aqui é obrigatório para rodar localmente.

DJANGO_SECRET_KEY=troque-por-uma-chave-longa-e-aleatoria
DJANGO_DEBUG=1
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# Vazio = SQLite local (backend/db.sqlite3). Em produção: postgres://usuario:senha@host:5432/banco
DATABASE_URL=

# Endereços do site que podem chamar a API (o Vite roda em 5173)
CORS_ALLOWED_ORIGINS=http://localhost:5173

# Cloudflare R2 para as imagens do painel. Vazio = pasta backend/media/ local.
R2_ACCOUNT_ID=
R2_BUCKET=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
# Domínio público do bucket, sem https:// (ex.: media.seudominio.dev.br)
R2_PUBLIC_DOMAIN=

# E-mail que recebe o aviso de cada mensagem do formulário
NOTIFY_EMAIL=dudulopesantos22@gmail.com

# Resend (resend.com): com a API key, o e-mail sai pela API HTTP deles (é o que roda em produção,
# porque o Render free bloqueia SMTP). DEFAULT_FROM_EMAIL precisa ser de um domínio verificado no Resend.
RESEND_API_KEY=

# Alternativa sem Resend: SMTP. Sem RESEND_API_KEY e sem EMAIL_HOST, o e-mail é só impresso no terminal.
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=1
DEFAULT_FROM_EMAIL=Portfólio <contato@luislopes.dev.br>

# WhatsApp Cloud API (Meta). Sem token, a confirmação no WhatsApp é pulada.
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
# Nome e idioma do modelo aprovado na Meta. O modelo recebe 1 variável: o nome da pessoa.
WHATSAPP_TEMPLATE=contato_recebido
WHATSAPP_TEMPLATE_LANG=pt_BR
